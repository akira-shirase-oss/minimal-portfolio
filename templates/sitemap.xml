{#- Zola's own sitemap (from the 0.23.6 binary), plus a <lastmod> for the
    two section pages (home, the build log): they list the posts, so they
    last changed when the newest post appeared. ISO dates sort as text. -#}
{%- set newest = [e.updated for e in entries if e.updated] | sort | last -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {%- for sitemap_entry in entries %}
    <url>
        <loc>{{ sitemap_entry.permalink | escape_xml | safe }}</loc>
        {%- if sitemap_entry.updated %}
        <lastmod>{{ sitemap_entry.updated }}</lastmod>
        {%- elif newest %}
        <lastmod>{{ newest }}</lastmod>
        {%- endif %}
    </url>
    {%- endfor %}
</urlset>
