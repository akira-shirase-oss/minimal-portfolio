# Response headers on Cloudflare Pages (syntax:
# https://developers.cloudflare.com/pages/configuration/headers/).
# A request matching several rules gets all their headers.

# Every page and file.
/*
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # CSP lives here, not in a <meta> tag: a header is the real thing (a meta
  # can't set frame-ancestors and doesn't show in header audits). Policies
  # from meta and header would intersect, so there is exactly one. If a page
  # ever gains an inline script, its sha256 belongs in script-src below —
  # `node tools/check-csp.mjs --print` prints the hashes the build needs, and
  # the plain check fails on missing or stale ones.
  # style-src keeps 'unsafe-inline': Zola's syntax highlighter and table
  # alignment emit ~1,500 style= attributes, which can't be hash-allowed
  # without 'unsafe-hashes' (patchy browser support). Script hashes cover
  # elements, not attributes — there is no portable hash path for them.
  # static.cloudflareinsights.com is in script-src for the Web Analytics
  # beacon Cloudflare injects at the edge; its posts go to same-origin
  # /cdn-cgi/rum, already covered by connect-src 'self'.
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com 'sha256-DuL2ryLe0jgoVHNq9X7ExNHad0CLFyZuF3I9V3+dHFE='; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# The same site also answers on www. and on its pages.dev addresses. Keep
# those out of search results, so 404human.dev is the one that's indexed
# (every page also names it with <link rel="canonical">).
https://www.404human.dev/*
  X-Robots-Tag: noindex
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# The stylesheet is always linked as ?h=<hash of its content>,
# so a changed file gets a new address: browsers may keep it for a year.
/style.css
  Cache-Control: public, max-age=31536000, immutable

# The self-hosted font is only replaced when its file name changes: a month.
/fonts/*
  Cache-Control: public, max-age=2592000

# Pictures and icons change rarely (and keep their names when they do): a month.
/img/*
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
/icon-192.png
  Cache-Control: public, max-age=2592000
/icon-512.png
  Cache-Control: public, max-age=2592000
